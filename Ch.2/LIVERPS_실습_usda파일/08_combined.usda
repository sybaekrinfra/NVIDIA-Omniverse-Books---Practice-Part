#usda 1.0
(
    defaultPrim = "World"
)
class "InheritSource"
{
    color3f primvars:displayColor = (1, 0.5, 0)
}
class "SpecializeSource"
{
    color3f primvars:displayColor = (0.5, 0.5, 0.5)
}
def Xform "World"
{
    def Cube "Cube" (
        inherits = </InheritSource>
        specializes = </SpecializeSource>
        prepend payload = @./source_payload.usda@
        prepend references = @./source_reference.usda@
        prepend variantSets = "colorVariant"
        variants = { string colorVariant = "yellow" }
    )
    {
        variantSet "colorVariant" = {
            "yellow" {
                color3f primvars:displayColor = (1, 1, 0)
            }
        }
        color3f primvars:displayColor = (1, 0, 0)
    }
}
