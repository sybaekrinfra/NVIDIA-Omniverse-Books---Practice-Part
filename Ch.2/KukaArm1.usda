#usda 1.0
(
    defaultPrim = "SensorModule"
)

def Xform "SensorModule"
{
    def Cylinder "Body"
    {
        double radius = 15
        double height = 40
        color3f primvars:displayColor = (0.2, 0.6, 0.9)
    }
    def Sphere "Sensor"
    {
        double radius = 8
        double3 xformOp:translate = (0, 0, 25)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f primvars:displayColor = (1, 0.3, 0.1)
    }
}