#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Ground"
    {
        color3f[] primvars:displayColor = [(0.22, 0.25, 0.3)]
        double size = 1
        float3 xformOp:scale = (8, 6, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Workpiece"
    {
        color3f[] primvars:displayColor = [(0.2, 0.5, 0.9)]
        double size = 1
        float3 xformOp:scale = (0.2, 0.2, 0.2)
        double3 xformOp:translate = (1, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Equipment" (
        delete apiSchemas = ["PhysicsArticulationRootAPI"]
        prepend references = @../shared/assets/cad/BX200L-C001.usd@</World>
    )
    {
        double3 xformOp:translate = (-1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "link0" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "link1" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "link2" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "link3" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "link4" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "link5" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "link6" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "Colliders" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }

        over "Joints"
        {
            over "joint1" (
                active = false
            )
            {
            }

            over "joint2" (
                active = false
            )
            {
            }

            over "joint3" (
                active = false
            )
            {
            }

            over "joint4" (
                active = false
            )
            {
            }

            over "joint5" (
                active = false
            )
            {
            }

            over "joint6" (
                active = false
            )
            {
            }
        }

        over "root_joint" (
            active = false
        )
        {
        }
    }

    def Sphere "StatusLamp"
    {
        color3f[] primvars:displayColor = [(0.05, 0.8, 0.2)]
        double radius = 0.15
        double3 xformOp:translate = (0, 0, 2.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 800
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.1, 1000)
        matrix4d xformOp:transform = ( (0.845488903030971, 0.5339929913879816, 2.77555756156289e-17, 0), (-0.21709902331854306, 0.3437401202543598, 0.9136250564655353, -0), (0.487869376909045, -0.7724598467726547, 0.40655781409087083, 0), (5.999999999999999, -9, 5.999999999999999, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

