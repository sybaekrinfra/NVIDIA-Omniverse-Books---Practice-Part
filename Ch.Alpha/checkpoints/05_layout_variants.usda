#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @02_structured.usda@
    ]
    upAxis = "Z"
)

over "World" (
    variants = {
        string layout = "compact"
    }
    prepend variantSets = "layout"
)
{
    variantSet "layout" = {
        "compact" {
            def "Trays"
            {
                def Cube "Tray_1"
                {
                    color3f[] primvars:displayColor = [(0.45, 0.5, 0.55)]
                    double size = 1
                    float3 xformOp:scale = (0.35, 0.6, 0.12)
                    double3 xformOp:translate = (0.4, -1.1, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Tray_2"
                {
                    color3f[] primvars:displayColor = [(0.45, 0.5, 0.55)]
                    double size = 1
                    float3 xformOp:scale = (0.35, 0.6, 0.12)
                    double3 xformOp:translate = (0.8500000000000001, -1.1, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Tray_3"
                {
                    color3f[] primvars:displayColor = [(0.45, 0.5, 0.55)]
                    double size = 1
                    float3 xformOp:scale = (0.35, 0.6, 0.12)
                    double3 xformOp:translate = (1.3, -1.1, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

        }
        "wide" {
            def "Trays"
            {
                def Cube "Tray_1"
                {
                    color3f[] primvars:displayColor = [(0.45, 0.5, 0.55)]
                    double size = 1
                    float3 xformOp:scale = (0.35, 0.6, 0.12)
                    double3 xformOp:translate = (0.4, -1.1, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Tray_2"
                {
                    color3f[] primvars:displayColor = [(0.45, 0.5, 0.55)]
                    double size = 1
                    float3 xformOp:scale = (0.35, 0.6, 0.12)
                    double3 xformOp:translate = (1.25, -1.1, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Tray_3"
                {
                    color3f[] primvars:displayColor = [(0.45, 0.5, 0.55)]
                    double size = 1
                    float3 xformOp:scale = (0.35, 0.6, 0.12)
                    double3 xformOp:translate = (2.1, -1.1, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

        }
    }
}

