#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @02_structured.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    def Xform "Batch"
    {
        def Cube "Part_00_00"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.85)]
            double size = 1
            custom string training:part_id = "P001"
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (0.5, -1.5, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Part_00_01"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.85)]
            double size = 1
            custom string training:part_id = "P002"
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (0.95, -1.5, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Part_00_02"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.85)]
            double size = 1
            custom string training:part_id = "P003"
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (1.4, -1.5, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Part_01_00"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.85)]
            double size = 1
            custom string training:part_id = "P004"
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (0.5, -1.05, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Part_01_01"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.85)]
            double size = 1
            custom string training:part_id = "P005"
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (0.95, -1.05, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Part_01_02"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.85)]
            double size = 1
            custom string training:part_id = "P006"
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (1.4, -1.05, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

