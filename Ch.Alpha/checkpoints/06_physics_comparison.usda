#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @03_physics.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Workpiece" (
        active = false
    )
    {
    }

    def "Experiment"
    {
        def Cube "A" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
            color3f[] primvars:displayColor = [(0.25, 0.5, 0.75)]
            double size = 1
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (0.5, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "B" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 5
            color3f[] primvars:displayColor = [(0.65, 0.5, 0.75)]
            double size = 1
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (1.1, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "C" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
            color3f[] primvars:displayColor = [(0.25, 0.5, 0.75)]
            double size = 1
            float3 xformOp:scale = (0.2, 0.2, 0.2)
            double3 xformOp:translate = (1.7, 0, 2.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

