#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @03_physics.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "StatusLamp"
    {
        color3f[] primvars:displayColor = [(0.9, 0.05, 0.05)]
    }

    over "Equipment"
    {
        custom string training:source = "SYNTHETIC_CSV"
        custom string training:state = "ALARM"
        custom float training:temperature_c = 80
        custom double training:time_s = 4
        custom float training:vibration_mm_s = 5
    }
}

