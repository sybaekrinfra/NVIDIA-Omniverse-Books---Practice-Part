#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "ReferencePart" (
        prepend references = @part.usda@
    )
    {
        double3 xformOp:translate = (-1, 0, 0)
    }

    def "PayloadPart" (
        prepend payload = @part.usda@
    )
    {
        double3 xformOp:translate = (1, 0, 0)
    }
}

